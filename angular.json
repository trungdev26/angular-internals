{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "base-angular": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/base-angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "./node_modules/@fontsource/be-vietnam-pro/400.css",
              "./node_modules/@fontsource/be-vietnam-pro/500.css",
              "./node_modules/@fontsource/be-vietnam-pro/600.css",
              "./node_modules/@fontsource/be-vietnam-pro/700.css",
              "./node_modules/@fontsource/be-vietnam-pro/800.css",
              "./node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
              "./node_modules/github-markdown-css/github-markdown-light.css",
              "./node_modules/prismjs/themes/prism-tomorrow.css",
              "src/styles.css"
            ],
            "scripts": [
              "node_modules/mermaid/dist/mermaid.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kb",
                  "maximumError": "16kb"
                }
              ],
              "allowedCommonJsDependencies": [
                "mousetrap",
                "prismjs",
                "prismjs/components/prism-bash",
                "prismjs/components/prism-csharp",
                "prismjs/components/prism-css",
                "prismjs/components/prism-javascript",
                "prismjs/components/prism-json",
                "prismjs/components/prism-markup",
                "prismjs/components/prism-scss",
                "prismjs/components/prism-sql",
                "prismjs/components/prism-typescript"
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "base-angular:build:production"
            },
            "development": {
              "buildTarget": "base-angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "base-angular:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "./node_modules/@fontsource/be-vietnam-pro/400.css",
              "./node_modules/@fontsource/be-vietnam-pro/500.css",
              "./node_modules/@fontsource/be-vietnam-pro/600.css",
              "./node_modules/@fontsource/be-vietnam-pro/700.css",
              "./node_modules/@fontsource/be-vietnam-pro/800.css",
              "./node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
              "./node_modules/github-markdown-css/github-markdown-light.css",
              "./node_modules/prismjs/themes/prism-tomorrow.css",
              "src/styles.css"
            ],
            "scripts": [
              "node_modules/mermaid/dist/mermaid.min.js"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "f0ddf305-578f-46cc-af46-ec2826e11ba5"
  }
}
